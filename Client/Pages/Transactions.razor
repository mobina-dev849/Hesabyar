@page "/transactions"

@using System.Net.Http.Json
@using Common.Helpers
@using Shared.Dtos

@using Shared.Enums
@using Microsoft.JSInterop


@inject HttpClient Http
@inject ILocalStorageService LocalStorage


<h3>حساب‌های من</h3>
@if (!isLoggedIn)
{
    <div class="alert alert-warning">
        لطفاً ابتدا وارد حساب کاربری خود شوید.
    </div>
}
else if (isLoading)
{
    <p>در حال دریافت حساب‌ها...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p>@errorMessage</p>
}
else if (accounts is null || accounts.Count == 0)
{
    <p>هنوز حسابی نداری.</p>
}
else
{
    <div class="card border-0 shadow-sm mb-3" style="background-color: #eaf7f0;">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="text-success">مجموع حساب‌ها</div>
                <strong class="text-success">
                    @FormatBalance(accounts.Sum(account => account.Balance))
                </strong>
            </div>

            <span class="rounded-circle bg-white p-3">💳</span>
        </div>
    </div>

    <div class="row g-3">

        @foreach (var account in accounts)
        {
            <div class="col-12">
                <a href="@($"/details/{account.PersonId}")"
                   class="text-decoration-none text-dark">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-light text-secondary d-flex align-items-center justify-content-center"
                                     style="width: 48px; height: 48px;">
                                    👤
                                </div>

                                <div>
                                    <h5 class="mb-1">@account.FullName</h5>
                                    <span class="@(account.Balance > 0 ? "text-success" : account.Balance < 0 ? "text-danger" : "text-muted")">
                                        @FormatBalance(account.Balance)
                                    </span>
                                </div>
                            </div>


                            <span class="text-secondary fs-4">‹</span>
                        </div>
                    </div>
                </a>
            </div>

       
        }
    </div>
}
@code
{
    private List<AccountDto>? accounts;
    private bool isLoggedIn;
    private bool isLoading;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var token = LocalStorage.GetItem<string>("authToken");

        if (string.IsNullOrWhiteSpace(token))
            return;

        isLoggedIn = true;
        isLoading = true;

        try
        {
            accounts = await Http.GetFromJsonAsync<List<AccountDto>>(
                "api/Transaction/accounts");
        }
        catch (HttpRequestException)
        {
            errorMessage = "بارگذاری حساب‌ها با خطا مواجه شد.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatBalance(decimal balance)
    {
        if (balance > 0)
            return $"{balance:N0} تومان طلبکارم";

        if (balance < 0)
            return $"{Math.Abs(balance):N0} تومان بدهکارم";

        return "تسویه";
    }
}
