@page "/details/{PersonId:long}"
@using System.Net.Http.Json
@using System.Linq
@using Common.Helpers
@using Shared.Dtos

@inject HttpClient Http
@inject ILocalStorageService LocalStorage

<PageTitle>جزئیات حساب</PageTitle>

<h3>جزئیات حساب</h3>

<div class="container-fluid py-3" dir="rtl">
    <div class="d-flex align-items-center gap-3">
        <a href="/" class="btn btn-light rounded-circle">‹</a>
        <h3 class="mb-0">@accountName</h3>
    </div>
</div>



@if (!isLoggedIn)
{
    <p>لطفاً ابتدا وارد حساب کاربری خود شوید.</p>
}
else if (isLoading)
{
    <p>در حال دریافت تراکنش‌ها...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p>@errorMessage</p>
}
else if (transactions is null || transactions.Count == 0)
{
    <p>تراکنشی برای این حساب پیدا نشد.</p>
}
else
{
    if (accounts != null && accounts.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-3" style="background-color: #eaf7f0;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-success">مجموع حساب‌</div>
                    <strong class="text-success">
                        @FormatBalance(accounts.Sum(account => account.Balance))
                    </strong>
                </div>

                <span class="rounded-circle bg-white p-3">💳</span>
            </div>
        </div>
    }

    @foreach (var dayGroup in transactions
    .GroupBy(t => t.TransactionDate.ToPersianDate())
    .OrderByDescending(group => group.Key))
    {
        <div class="d-flex align-items-center gap-3 my-4">
            <span class="flex-grow-1"
                  style="height: 1px; background-color: #dee2e6;">
            </span>

            <span class="text-secondary small">
                @dayGroup.Key
            </span>

            <span class="flex-grow-1"
                  style="height: 1px; background-color: #dee2e6;">
            </span>
        </div>

        @foreach (var transaction in dayGroup)
        {
            var userIsCreator = transaction.CreatorId != PersonId;
            var isPayment = transaction.Type == Domain.Entities.Transaction.TransactionType.Payment;
            var isRed = userIsCreator == isPayment;

            <div class="d-flex mb-3 position-relative"
                 style="column-gap: 12px; padding-left: 57px;"
                 dir="rtl">

                
                <div class="card flex-grow-1 position-relative">
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(transaction.Title))
                        {
                            <h5 class="mb-2">@transaction.Title</h5>
                        }

                        
                        <div class="d-flex justify-content-between align-items-center">
                          
                            <strong>
                                @transaction.Amount.ToString("N0") تومان
                            </strong>

                            

                        </div>

                        @if (!string.IsNullOrWhiteSpace(transaction.Explainn))
                        {
                            <p class="mt-2 mb-0">@transaction.Explainn</p>
                        }

                        <div class="mt-3">
                            <span class="badge @GetStatusClass(transaction.Status.ToString())">
                                @GetStatusText(transaction.Status.ToString())
                            </span>
                        </div>
                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-white
                            @(isRed ? "bg-danger" : "bg-success")"
                              style="position: absolute; left: 24px; top: 50%;
                                    transform: translateY(-50%); width: 36px; height: 36px;">
                            @(isRed ? "←" : "→")
                        </span>
                    </div>
                    <span class="text-muted small"
                          style="position: absolute; left: -57px; top: 50%;
                        transform: translateY(-50%); width: 45px; text-align: center;">
                        @transaction.TransactionDate.ToIranTime().ToString("HH:mm")
                    </span>

                </div>
            </div>
        }

    }
}

@code {
    [Parameter]
    public long PersonId { get; set; }

    private List<TransactionDto>? transactions;
    private bool isLoggedIn;
    private bool isLoading;
    private string errorMessage = "";
    private string accountName = "جزئیات حساب";
    private List<AccountDto>? accounts;
    


    protected override async Task OnParametersSetAsync()
    {
        var token = LocalStorage.GetItem<string>("authToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            isLoggedIn = false;
            return;
        }

        isLoggedIn = true;
        isLoading = true;
        errorMessage = "";

        try
        {
            var userTransactions =
                await Http.GetFromJsonAsync<List<TransactionDto>>("api/Transaction");

            transactions = userTransactions?
                .Where(t => t.CreatorId == PersonId || t.CounterpartyId == PersonId)
                .ToList() ?? new List<TransactionDto>();

            var userAccounts =
                 await Http.GetFromJsonAsync<List<AccountDto>>("api/Transaction/accounts");

            accounts = userAccounts?
                .Where(t => t.PersonId == PersonId)
                .ToList() ?? new List<AccountDto>();


            if (transactions.Count > 0)
            {
                var firstTransaction = transactions[0];

                accountName = firstTransaction.CreatorId == PersonId
                    ? firstTransaction.CreatorName
                    : firstTransaction.CounterpartyName;
            }

        }
        catch (HttpRequestException)
        {
            errorMessage = "بارگذاری تراکنش‌ها با خطا مواجه شد.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetTypeText(string type) => type switch
    {
        "Payment" => "پرداخت",
        "Receipt" => "دریافت",
        _ => type
    };

    private static string GetStatusText(string status) => status switch
    {
        "Pending" => "در انتظار تأیید",
        "Approved" => "تأیید شده",
        "Rejected" => "رد شده",
        _ => "نامشخص"
    };

    private static string GetStatusClass(string status) => status switch
    {
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "Pending" => "bg-warning text-dark",
        _ => "bg-secondary"
    };


    private static string FormatBalance(decimal balance)
    {
        if (balance > 0)
            return $"{balance:N0} تومان طلبکارم";

        if (balance < 0)
            return $"{Math.Abs(balance):N0} تومان بدهکارم";

        return "تسویه";
    }
}
